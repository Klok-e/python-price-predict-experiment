[Unit]
Description=Net-Growth Forward Paper Proof
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/Desktop/python-price-predict-experiment
ExecStart=%h/Desktop/python-price-predict-experiment/.venv/bin/netgrowth paper --device cuda
Restart=on-failure
RestartSec=15s
Environment=MIOPEN_LOG_LEVEL=0

[Install]
WantedBy=default.target
